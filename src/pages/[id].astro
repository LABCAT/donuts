---
import SketchLayout from '@labcat2020/animation-lab/layouts/SketchLayout.astro';
import { sketchMetadata } from '@/sketchMetadata.js';
import config from '@/project.config.js';
import DonutsStemControls from '@/components/DonutsStemControls.astro';

export async function getStaticPaths() {
  return Object.keys(sketchMetadata).map((id) => ({
    params: { id },
    props: { sketchInfo: sketchMetadata[id] },
  }));
}

const { sketchInfo } = Astro.props;
---

<SketchLayout
  title={sketchInfo.title}
  description={sketchInfo.description}
  gtmId={config.gtmId}
  hashLips={true}
  header={true}
  showFps={true}
  trackNav={true}
>
  <DonutsStemControls hidden={sketchInfo.sketch !== 'DonutsNo4.js'} />
</SketchLayout>

<style is:global>
  /* No room for the track name beside the panel's buttons on a phone (below the lab's md). */
  @media (max-width: 767.98px) {
    .lab-control-panel__track {
      display: none;
    }
  }
</style>

<script>
  import { startSeries } from '@sketches/DonutsSeries.js';
  import { startNo4Series } from '@sketches/DonutsNo4Series.js';

  const pathSegments = window.location.pathname.split('/');
  const sketchId =
    pathSegments[pathSegments.length - 1] ||
    pathSegments[pathSegments.length - 2];

  // No1–No3 are hosted by the lab suite (parts flow into each other). No4 still
  // has its own stem transport, so it keeps the legacy player.
  const start = sketchId === 'number-4' ? startNo4Series : startSeries;

  start(sketchId)
    .then(() => {
      console.log('Sketch loaded successfully!');
    })
    .catch((err) => {
      console.error('Failed to load sketch:', err);
    });
</script>
