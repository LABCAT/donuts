---
// Stem mute buttons for DonutsNo4, a row joined to the top of the lab
// ControlPanel. Talks to the sketch through window events:
//   dispatch 'donuts:stem-toggle' → { detail: { id } }
//   listen   'donuts:stems'       → { detail: { on: { [id]: boolean } } }
import { STEMS } from '@/audioTracks.js';

const { hidden = false } = Astro.props;

const ICONS: Record<string, string> = {
  theme: '<path class="donuts-stem-controls__solid" d="M12 3v10.55A4 4 0 1 0 14 17V7h4V3h-6z" />',
  drums:
    '<ellipse cx="12" cy="10" rx="8" ry="3" /><path d="M4 10v7c0 1.66 3.58 3 8 3s8-1.34 8-3v-7M7 2l5 7M17 2l-5 7" />',
  piano:
    '<rect x="3" y="4" width="18" height="16" rx="1" /><path class="donuts-stem-controls__solid" d="M8 4h2v9H8zM14 4h2v9h-2z" /><path d="M9 13v7M15 13v7" />',
  brass: '<path d="M2 11h12M14 11l7-5v12l-7-5M5 11v4a2 2 0 0 0 2 2h5a2 2 0 0 0 2-2v-4M8 11V7M11 11V7" />',
};
---

<div class="donuts-stem-controls" role="group" aria-label="Stems" hidden={hidden}>
  {
    STEMS.map((stem, i) => (
      <button
        type="button"
        class="donuts-stem-controls__btn"
        data-stem={stem.id}
        aria-pressed="true"
        aria-label={stem.label}
        title={`${stem.label} on/off (${i + 1})`}
      >
        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false" set:html={ICONS[stem.id]} />
      </button>
    ))
  }
</div>

<style lang="scss">
  .donuts-stem-controls {
    // Sits flush on the panel's cluster: 44px buttons + 8px padding + 1px border.
    position: fixed;
    right: 0;
    bottom: 53px;
    z-index: 1000;
    display: flex;
    padding: 0 8px;
    background: var(--lab-header-bg);
    border-top: 1px solid var(--lab-header-border);
    border-left: 1px solid var(--lab-header-border);

    &[hidden] {
      display: none;
    }
  }

  .donuts-stem-controls__btn {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    min-width: 44px;
    min-height: 44px;
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--lab-white);
    cursor: pointer;

    &:hover {
      color: var(--lab-pink);
    }

    &:focus-visible {
      outline: 2px solid var(--rs-color-focus-ring);
      outline-offset: 2px;
      border-radius: 4px;
    }

    :global(svg) {
      display: block;
      width: 26px;
      height: 26px;
      fill: none;
      stroke: currentColor;
      stroke-width: 1.8;
      stroke-linecap: round;
      stroke-linejoin: round;
    }

    :global(.donuts-stem-controls__solid) {
      fill: currentColor;
      stroke: none;
    }

    // Muted: dimmed, with a slash through the icon.
    &[aria-pressed='false'] :global(svg) {
      opacity: 0.4;
    }

    &[aria-pressed='false']::after {
      content: '';
      position: absolute;
      top: 50%;
      left: 50%;
      width: 32px;
      height: 2px;
      background: currentColor;
      transform: translate(-50%, -50%) rotate(-45deg);
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-stem]').forEach((button) => {
    button.addEventListener('click', () => {
      window.dispatchEvent(new CustomEvent('donuts:stem-toggle', { detail: { id: button.dataset.stem } }));
    });
  });

  window.addEventListener('donuts:stems', (event) => {
    const on = (event as CustomEvent<{ on: Record<string, boolean> }>).detail.on;
    document.querySelectorAll<HTMLButtonElement>('[data-stem]').forEach((button) => {
      button.setAttribute('aria-pressed', String(on[button.dataset.stem ?? '']));
    });
  });
</script>
